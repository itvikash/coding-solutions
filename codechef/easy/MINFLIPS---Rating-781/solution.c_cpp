#include <bits/stdc++.h>
using namespace std;
#define int long long

int32_t main() {
	// your code goes here
    int t; cin>>t;
    while(t--){
        int n; cin>>n;
        vector<int> v(n);
        int cm = 0;
        for(int i=0; i<n; i++){
            cin >> v[i];
            if(v[i]==-1) cm++;
        }
        
        if(n&1) {cout << -1 << endl; continue;}
        int ans = abs(n/2 - cm);
        cout << ans << endl;
        
    }
}
